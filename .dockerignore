# Reduz o contexto de build e — crítico — mantém segredos fora da imagem.
# Sem isto o `next build` carregaria .env.local e embutiria/vazaria segredos.
node_modules
.next
.git
.env
.env.*
test-results
tests
playwright.config.ts
*.png
*.log
.lina
# The runtime ontology registry imports this committed snapshot at build time.
# Keep the rest of the audit archive out of the image.
docs/*
!docs/audits/
docs/audits/*
!docs/audits/ontology-32/
!docs/audits/ontology-32/snapshot-v1.json
tasks
scratchpad
.vercel
# Harness de sessão de IA (skills, hooks, config de CLI): não é código de
# runtime e entrava inteiro na imagem do worker (`COPY . .`).
.claude
.agents
.agent
.codex
.cursor
.opencode
.specs
.changes

# Artefatos locais de QA não fazem parte do runtime.
evidence
.superpowers
*.tsbuildinfo
